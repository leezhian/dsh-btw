{
  "name": "@kami232/dsh-btw",
  "version": "0.7.0",
  "type": "module",
  "description": "btw side chat: a throwaway, isolated side conversation for DeepSeek Harness — native conversation UI, zero context flow-back, discarded on close",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "side-chat",
    "temporary-chat",
    "btw"
  ],
  "author": "kim",
  "engines": {
    "node": ">=18"
  }
}
